# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — NUNCA commitar segredos. Vercel lê das Environment Variables.
.env
.env.local
.env*.local
# exceção: template sem segredos
!.env.example

# documentos de produto (referência local, não vão pro deploy)
/*.pdf
/*.docx

# vercel
.vercel

# claude code local settings
.claude/settings.local.json

# typescript
*.tsbuildinfo
next-env.d.ts
public/images/.next/

# AIOX framework runtime deps
.aiox-core/node_modules/
.aiox/

# Supabase local temp
supabase/.temp/
